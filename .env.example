# Local SQLite file. Docker Compose overrides this with its persistent volume path.
DATABASE_URL=./data/secret-santa.sqlite

# Local wishlist image storage and per-image limit (5 MiB by default).
UPLOADS_DIR=./data/uploads
MAX_IMAGE_BYTES=5242880

# Local development server
PORT=3000
ORIGIN=http://localhost:3000

# One-time organizer bootstrap; keep the password out of source control.
INITIAL_ORGANIZER_USERNAME=organizer
INITIAL_ORGANIZER_DISPLAY_NAME=Organizer
INITIAL_ORGANIZER_PASSWORD=
