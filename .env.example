# Local SQLite file. Docker Compose overrides this with its persistent volume path.
DATABASE_URL=./data/secret-santa.sqlite

# Local image storage and per-image limit (10 MiB by default).
UPLOADS_DIR=./data/uploads
MAX_IMAGE_BYTES=10485760

# Local development server. Keep BASE_PATH empty when running pnpm dev.
PORT=3000
ORIGIN=http://localhost:3000
BASE_PATH=

# Docker deployment. Replace these values with the DNS name and email used for TLS.
DOMAIN=localhost
PUBLIC_ORIGIN=https://localhost
APP_BASE_PATH=/secret-santa
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_EMAIL=

# One-time organizer bootstrap; keep the password out of source control.
INITIAL_ORGANIZER_USERNAME=organizer
INITIAL_ORGANIZER_DISPLAY_NAME=Organizer
INITIAL_ORGANIZER_PASSWORD=
